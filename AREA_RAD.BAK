#include <stdio.h>
int main () {
float raduis,area,circumference;
printf("Enter the number of radius:");
scanf("%f",raduis);
area = 3.14 * raduis * raduis;
circumference = 2 * 3.14 * raduis;
printf("\narea of a circle:%.2f",area);
printf("\ncircumference of a circle:%.2f",circumference);
return 0;
}
